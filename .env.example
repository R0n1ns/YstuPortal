# App
PORT=8080
DATABASE_URL=postgres://user:user@localhost:5432/ystu_db?sslmode=disable

# Auth
JWT_SECRET=change-me
JWT_TTL=24h
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=10m

# Rate limit
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1m

# Swagger
SWAGGER_ENABLED=true

